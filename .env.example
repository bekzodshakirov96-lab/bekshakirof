# Copy this file to .env and fill in real values before running the app.

# MySQL connection string. Any MySQL 8+ compatible server works (self-hosted,
# Railway, PlanetScale, RDS, etc). Format:
# mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=

# Secret used to sign login session tokens (JWT). Must be a long, random,
# unguessable string — treat it like a password. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing this value logs every user out (existing session tokens become invalid).
JWT_SECRET=

# Port the server listens on. Defaults to 3000 if not set.
PORT=3000

# Where uploaded files (imported Excel workbooks, etc.) are stored on disk.
# Defaults to ./uploads relative to the project root if not set. Point this at
# a persistent volume/disk in production so uploads survive redeploys.
UPLOADS_DIR=./uploads

# Timezone the server computes "day" boundaries in (Kassa, daily/period reports).
# The business operates in Tashkent, so this defaults to Asia/Tashkent even if unset —
# important when deploying to a cloud host, since those usually default to UTC, which
# would otherwise shift every day boundary. Only set this if you deploy for a business
# in a different timezone.
TZ=Asia/Tashkent

# SaaS stage 1: one isolated application deployment and MySQL database per company.
# Leave legacy mode for the existing installation until backup/binding checks pass.
TENANCY_MODE=legacy
# In isolated mode these are REQUIRED. Use legacy for the original company so
# existing uploads retain their paths; other IDs get separate upload directories.
# TENANT_ID=legacy
# TENANT_HOSTS=www.biznescontrol.uz,biznescontrol.uz,your-healthcheck-host.up.railway.app
# DATABASE_URL must use a database user granted access ONLY to this company's DB.
# Use a distinct JWT_SECRET and persistent volume for every deployment.
# See docs/saas-tenant-isolation.md before enabling isolated mode.
# Current code also requires the explicit tenant_id schema preparation in
# docs/saas-tenant-query-scope.md, INCLUDING legacy mode. Do not deploy before
# its restored-staging backup/migration checks pass. No automatic migration runs.

# SaaS control plane: a SEPARATE process, database and hostname.
# Start with npm run platform:dev (4180) or NODE_ENV=production npm run platform:start.
# Do not put these credentials in any company's environment.
# PLATFORM_DATABASE_URL=mysql://PLATFORM_ONLY_USER:PASSWORD@HOST:3306/platform_db
# PLATFORM_ORIGIN=https://platform.biznescontrol.uz
# PLATFORM_MAIL_MODE=resend
# RESEND_API_KEY=
# PLATFORM_MAIL_FROM=BiznesControl <accounts@your-verified-domain.uz>
# Local testing only: PLATFORM_MAIL_MODE=local writes private verification links
# to data/platform-local-mail.jsonl; startup refuses local mail in production.
# PLATFORM_ADMIN_EMAIL and PLATFORM_ADMIN_PASSWORD are used ONLY by the
# explicit operator command `npm run platform:ops -- admin`. Never commit them.
# Provisioning: NEW_COMPANY_DATABASE_URL points to a separate EMPTY business DB.

# SaaS subscription billing: platform process/database ONLY. Off by default.
# Run platform:ops billing-init explicitly for an existing platform DB.
# Monthly UZS price is versioned in the DB by Super admin, never the browser.
# PLATFORM_BILLING_MODE=off
# Modes: off | test (non-production separate platform) | live (production only).
# PAYME_MERCHANT_ID=
# PAYME_MERCHANT_KEY=
# CLICK_MERCHANT_ID=
# CLICK_SERVICE_ID=
# CLICK_MERCHANT_USER_ID=
# CLICK_SECRET_KEY=
# Never mix test and live merchant keys or put these in a firm's environment.
# Callbacks: /api/platform/billing/callbacks/payme and /click on PLATFORM_ORIGIN.
# Merchant approval, provider sandbox acceptance and fiscal details are required
# before enabling live. No card data or automatic recurring debits are stored.

# Newly provisioned company runtimes ONLY (never the existing legacy firm):
# PLATFORM_MANAGED=true
# PLATFORM_CONTROL_URL=https://platform.biznescontrol.uz
# PLATFORM_RUNTIME_KEY=<unique random key generated by platform:ops provision>
# See docs/saas-control-plane.md for setup, verification and deployment limits.
