# Copy this file to .env and fill in real values before running the app.

# MySQL connection string. Any MySQL 8+ compatible server works (self-hosted,
# Railway, PlanetScale, RDS, etc). Format:
# mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=

# Secret used to sign login session tokens (JWT). Must be a long, random,
# unguessable string — treat it like a password. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing this value logs every user out (existing session tokens become invalid).
JWT_SECRET=

# Port the server listens on. Defaults to 3000 if not set.
PORT=3000

# Where uploaded files (imported Excel workbooks, etc.) are stored on disk.
# Defaults to ./uploads relative to the project root if not set. Point this at
# a persistent volume/disk in production so uploads survive redeploys.
UPLOADS_DIR=./uploads

# Timezone the server computes "day" boundaries in (Kassa, daily/period reports).
# The business operates in Tashkent, so this defaults to Asia/Tashkent even if unset —
# important when deploying to a cloud host, since those usually default to UTC, which
# would otherwise shift every day boundary. Only set this if you deploy for a business
# in a different timezone.
TZ=Asia/Tashkent
